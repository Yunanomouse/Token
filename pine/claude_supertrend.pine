// Claude's entry in the indicator duel (docs/indicator_duel.md). MIT, like the rest of this repository.
// Same formula as indicators/claude.py (TradingView's ta.supertrend), so the two agree bar for bar.
// Signals are on the bar's close; the duel's engine fills at the NEXT bar's open, 0.1% against you.
// A signal on the last bar starting before 15:30 (the 15:25 bar on 5 minutes) fills at the 15:30 open.
// The engine flattens at the open of the last bar starting at or before 15:55 New York time
// (quantum/signals.py flat_by_for: 15:55 on 5m, 15:45 on 15m, 15:30 on 30m and 60m), marked FLAT below.
// PAPER research only: this indicator places no orders.
//@version=5
indicator("Claude Supertrend (duel entry)", shorttitle="Claude ST", overlay=true)

atrPeriod = input.int(10, "ATR length", minval=1)
factor    = input.float(3.0, "ATR factor", minval=0.1, step=0.1)
entryHours = input.session("0930-1530", "New entries allowed (New York)")

[st, dir] = ta.supertrend(factor, atrPeriod)   // dir == -1: uptrend (long), dir == 1: downtrend
inWindow  = not na(time(timeframe.period, entryHours, "America/New_York"))

entry = dir == -1 and inWindow                  // Python: signals()["entry"] (plus the engine's entry cut-off)
exit_ = dir == 1                                // Python: signals()["exit"]
entryEdge = entry and not entry[1]              // rising edge only: alert once, not on every bar while true
exitEdge  = exit_ and not exit_[1]

// Flatten bar: 9:30 + floor((15:55 - 9:30) / tf) * tf, as the Python engine's flat_by.
tfMin    = timeframe.in_seconds(timeframe.period) / 60
flatMin  = 570 + math.floor((955 - 570) / tfMin) * tfMin   // 955 = 15:55, 570 = 9:30
barMin   = hour(time, "America/New_York") * 60 + minute(time, "America/New_York")
flatBar  = timeframe.isintraday and barMin == flatMin

plot(dir == -1 ? st : na, "Up trend",   color=color.new(color.green, 0), style=plot.style_linebr, linewidth=2)
plot(dir == 1  ? st : na, "Down trend", color=color.new(color.red, 0),   style=plot.style_linebr, linewidth=2)
plotshape(entryEdge, "Buy",  shape.triangleup,   location.belowbar, color.green, size=size.small, text="BUY")
plotshape(exitEdge,  "Sell", shape.triangledown, location.abovebar, color.red,   size=size.small, text="SELL")
plotshape(flatBar,   "Flatten", shape.xcross,    location.abovebar, color.gray,  size=size.tiny,  text="FLAT")
bgcolor(entry ? color.new(color.green, 92) : na, title="Long zone")

alertcondition(entryEdge, "Claude ST: buy",     "Supertrend long signal on {{ticker}} at {{close}}")
alertcondition(exitEdge,  "Claude ST: sell",    "Supertrend turned down on {{ticker}} at {{close}}")
alertcondition(flatBar,   "Claude ST: flatten", "Flatten {{ticker}} at this bar's open (15:55 on 5m; engine flat_by)")
