# Names of the secrets Token can use. Values never go in this file.
# Store each one in Bitwarden Secrets Manager under exactly this name, then
# run commands with:  bws run -- python examples/openbb_quickstart.py
# See docs/secrets.md.
#
# Token needs none of these today; the free Yahoo provider has no key.

# OpenBB data providers. OpenBB reads <PROVIDER>_API_KEY automatically, for
# example FRED (install openbb-fred). Add a line per provider you sign up for.
FRED_API_KEY=
